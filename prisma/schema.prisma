// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Card
// ---------------------------------------------------------------------------
model Card {
  id   String @id @default(cuid())
  body String // 記法（〈 〉）を含む本文。表面はここから生成する（ADR-001）

  sortKey Int @unique

  // --- 固定間隔スケジューリングの現在状態（ADR-013） -------------------------
  intervalStep Int      @default(0) // 固定間隔テーブルの添字（0〜4）
  dueDate      DateTime @default(now()) // 次回復習日。新規カードは即出題対象
  masteredAt   DateTime? // 定着完了日時。非nullのカードは出題対象外

  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  blanks     Blank[]
  reviewLogs ReviewLog[]

  @@index([masteredAt, dueDate]) // 「今日出題すべきカード」の抽出（定着済みを除外）
  @@index([sortKey]) // 一覧表示・次へ／前へ
}

// ---------------------------------------------------------------------------
// Blank
// ---------------------------------------------------------------------------
model Blank {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // 保存のたびに更新。同一性の解決に使う（ADR-009）
  ordinal   Int? // 本文中で何番目の穴か（0始まり）。削除済みは null
  answerKey String // 照合用に正規化した答え

  resetAt      DateTime @default(now()) // ミス回数の集計起点（6.4）
  maxMissCount Int      @default(0)

  // 復活のためではなく、マッチングの不具合でログが黙って消えるのを防ぐため
  deletedAt DateTime?

  logs BlankLog[]

  @@unique([cardId, ordinal]) // Postgres では null 同士は衝突しない
  @@index([cardId, deletedAt])
}

// ---------------------------------------------------------------------------
// BlankLog（追記専用）
// ---------------------------------------------------------------------------
model BlankLog {
  id      String @id @default(cuid())
  blankId String
  blank   Blank  @relation(fields: [blankId], references: [id], onDelete: Cascade)

  answeredAt DateTime @default(now())
  isCorrect  Boolean

  // ミス回数は保存せずここから導出する（ADR-004）
  @@index([blankId, answeredAt])
}

// ---------------------------------------------------------------------------
// ReviewLog（追記専用）
// ---------------------------------------------------------------------------
model ReviewLog {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  reviewedAt DateTime @default(now())
  isCorrect  Boolean // 「1つでもミスでagain」を集約した結果（ADR-005）

  // この回答の「結果としての」状態。Card の列はこの最新行のキャッシュ
  intervalStepAfter Int
  dueDateAfter      DateTime

  @@index([cardId, reviewedAt])
}