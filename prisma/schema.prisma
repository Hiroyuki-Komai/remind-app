// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Card
// ---------------------------------------------------------------------------
model Card {
  id   String @id @default(cuid())
  body String // 記法（〈 〉）を含む本文。表面はここから生成する（ADR-001）

  // 並び順。1000刻みで採番し、間に挿入するときは空きに差し込む（振り直し不要）
  sortKey Int @unique

  // --- SM-2 の現在状態 -------------------------------------------------------
  // ReviewLog 最新行のキャッシュ。dueDate に索引を張るために列として持つ
  repetition Int      @default(0) // 連続正解回数 n
  easeFactor Float    @default(2.5) // EF（下限 1.3）
  interval   Int      @default(0) // 次回までの日数
  dueDate    DateTime @default(now()) // 新規カードは即出題対象

  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  blanks     Blank[]
  reviewLogs ReviewLog[]

  @@index([dueDate]) // 「今日出題すべきカード」の抽出
  @@index([sortKey]) // 一覧表示・次へ／前へ
}

// ---------------------------------------------------------------------------
// Blank
// ---------------------------------------------------------------------------
model Blank {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // 保存のたびに更新。同一性の解決に使う（ADR-009）
  ordinal   Int? // 本文中で何番目の穴か（0始まり）。削除済みは null
  answerKey String // 照合用に正規化した答え

  resetAt      DateTime @default(now()) // ミス回数の集計起点（6.4）
  maxMissCount Int      @default(0)

  // 復活のためではなく、マッチングの不具合でログが黙って消えるのを防ぐため
  deletedAt DateTime?

  logs BlankLog[]

  @@unique([cardId, ordinal]) // Postgres では null 同士は衝突しない
  @@index([cardId, deletedAt])
}

// ---------------------------------------------------------------------------
// BlankLog（追記専用）
// ---------------------------------------------------------------------------
model BlankLog {
  id      String @id @default(cuid())
  blankId String
  blank   Blank  @relation(fields: [blankId], references: [id], onDelete: Cascade)

  answeredAt DateTime @default(now())
  isCorrect  Boolean

  // ミス回数は保存せずここから導出する（ADR-004）
  @@index([blankId, answeredAt])
}

// ---------------------------------------------------------------------------
// ReviewLog（追記専用）
// ---------------------------------------------------------------------------
model ReviewLog {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  reviewedAt DateTime @default(now())
  quality    Int // 2値運用：正解=5 / 不正解=2

  // この回答の「結果としての」状態。Card の4列はこの最新行のキャッシュ
  repetitionAfter Int
  easeFactorAfter Float
  intervalAfter   Int
  dueDateAfter    DateTime

  @@index([cardId, reviewedAt])
}
